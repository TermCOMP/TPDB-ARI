; sequential execution of two loops, where the first loop is a positively drifting random walk (J.-C. Kassing, dissertation, RWTH Aachen University, Chapter 5)

(format PTRS)

(fun loop1 2)
(fun s 1)
(fun |0| 0)
(fun loop2 1)

(prule (loop1 (s x) y) (((loop1 x (s y)) :prob 1 ) ((loop1 (s (s x)) (s y)) :prob 2 )))
(prule (loop1 |0| y) (((loop2 y) :prob 1 )))
(prule (loop2 (s y)) (((loop2 (s (s y))) :prob 1 ) ((loop2 y) :prob 1 )))
