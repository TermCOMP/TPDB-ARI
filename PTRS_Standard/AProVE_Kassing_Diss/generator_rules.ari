; PTRS P_6 together with its generator rules G(P_6) (J.-C. Kassing, dissertation, RWTH Aachen University, Chapter 4)

(format PTRS)

(fun f 1)
(fun a 0)
(fun d 1)
(fun |0| 0)
(fun c 2)
(fun encf 1)
(fun argenc 1)
(fun encd 1)
(fun encc 2)
(fun enca 0)
(fun encO 0)
(fun consf 1)
(fun consd 1)

(prule (f (f a)) (((d (f (f a))) :prob 3 ) (|0| :prob 1 )))
(prule (d x) (((c x x) :prob 1 )))
(prule (encf x1) (((f (argenc x1)) :prob 1 )))
(prule (encd x1) (((d (argenc x1)) :prob 1 )))
(prule (encc x1 x2) (((c (argenc x1) (argenc x2)) :prob 1 )))
(prule enca ((a :prob 1 )))
(prule encO ((|0| :prob 1 )))
(prule (argenc (consf x1)) (((f (argenc x1)) :prob 1 )))
(prule (argenc (consd x1)) (((d (argenc x1)) :prob 1 )))
(prule (argenc (c x1 x2)) (((c (argenc x1) (argenc x2)) :prob 1 )))
(prule (argenc a) ((a :prob 1 )))
(prule (argenc |0|) ((|0| :prob 1 )))
