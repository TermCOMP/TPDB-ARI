; PTRS P_unary (J.-C. Kassing, dissertation, RWTH Aachen University, Chapter 3)
; finite PTRS over a unary signature used to separate PAST and SAST

(format PTRS)

(fun f 1)
(fun s 1)
(fun b 0)
(fun g 1)
(fun |0| 0)
(fun g1 1)
(fun h 1)
(fun q 1)
(fun a 1)
(fun q1 1)
(fun q2 1)

(prule (f x) (((f (s x)) :prob 1 ) (b :prob 1 )))
(prule (f x) (((g x) :prob 1 )))
(prule (g |0|) ((|0| :prob 1 )))
(prule (g (s x)) (((g1 (s x)) :prob 1 )))
(prule (g1 (s x)) (((h (s x)) :prob 1 )))
(prule (h (s x)) (((q (h x)) :prob 1 )))
(prule (h |0|) (((a (a (a (a |0|)))) :prob 1 )))
(prule (q (a x)) (((q1 x) :prob 1 )))
(prule (q1 x) (((q2 x) :prob 1 )))
(prule (q2 x) (((a (a (a (a (q x))))) :prob 1 )))
