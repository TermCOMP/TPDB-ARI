; Count down a natural number and start a two-component cell process in every step. A cell dies
; with probability 2/3 and otherwise spawns new cells. The core is critical with Perron vector
; (aa, ab, ba, bb) = (1, 2, 1, 1).
; Expected: WORST_CASE(Non-SAST,AST). Class: not RNT, decided via the RNT backend of the ADP framework.

(format PTRS)

(fun loop 1) (fun zero 0) (fun s 1) (fun stop 0) (fun cell 1) (fun pair 2) (fun a 0) (fun b 0)
(fun e 0) (fun par 2) (fun par3 3) (fun par4 4)

(prule (loop zero) ((stop :prob 1)))
(prule (loop (s n)) (((par (cell (pair a b)) (loop n)) :prob 1)))
(prule (cell (pair a a)) ((e :prob 2) ((par3 (cell (pair a a)) (cell (pair b a)) (cell (pair b b))) :prob 1)))
(prule (cell (pair a b)) ((e :prob 2) ((par4 (cell (pair a b)) (cell (pair a b)) (cell (pair a a)) (cell (pair b b))) :prob 1)))
(prule (cell (pair b a)) ((e :prob 2) ((par3 (cell (pair b a)) (cell (pair b b)) (cell (pair a a))) :prob 1)))
(prule (cell (pair b b)) ((e :prob 2) ((par (cell (pair a b)) (cell (pair b b))) :prob 1)))
