(format LCTRS)
(theory Ints)
(fun __init (-> Int Int Int Int))
(fun f1_0_main_Load (-> Int Int Int Int))
(fun f203_0_main_NE (-> Int Int Int Int))
(fun f239_0_main_LE (-> Int Int Int Int))
(entrypoint __init)
(rule
(f1_0_main_Load arg1 arg2 arg3)
(f203_0_main_NE arg1P arg2 arg3)
:guard
(and
(and (and (> arg2 (- 1)) (> arg2_old (- 1))) (> arg1P (- 1)))
(> arg1 0))
)
