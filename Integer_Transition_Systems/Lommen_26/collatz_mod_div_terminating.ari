; Collatz function with mod and div

(format LCTRS)
(theory Ints)
(fun start (-> Int Int))
(fun collatz (-> Int Int))
(entrypoint start)
(rule (start n) (collatz n))
(rule (collatz n) (collatz (div n 2)) :guard (and (> n 1) (= (mod n 2) 0)))
(rule (collatz n) (collatz (+ (* 3 n) 1)) :guard (and (> n 1) (= (mod n 2) 1)))
