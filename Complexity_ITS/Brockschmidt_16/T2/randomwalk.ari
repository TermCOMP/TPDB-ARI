(format LCTRS)
(theory Ints)
(fun f0 (-> Int Int Int Int Int Int Int Int))
(fun f10 (-> Int Int Int Int Int Int Int Int))
(fun f21 (-> Int Int Int Int Int Int Int Int))
(fun f31 (-> Int Int Int Int Int Int Int Int))
(entrypoint f0)
(rule (f0 A B C D E F G) (f10 1 1 C 0 2 1 G) :guard (>= C 0))
(rule
  (f10 A B C D E F G)
  (f21 A (- B 1) C D E F 0)
  :guard
  (and (and (and (>= F 1) (>= E F)) (>= B 1)) (>= 0 C)))
(rule
  (f10 A B C D E F G)
  (f21 (+ A 1) (+ A 1) H D E F I)
  :guard
  (and
    (and
      (and (and (and (and (>= I 0) (>= 1 I)) (>= H 0)) (>= F 1)) (>= E F))
      (>= 0 B))
    (>= 0 C))
  )
(rule
  (f10 A B C D E F G)
  (f21 A B (- C 1) D E F H)
  :guard
  (and (and (and (and (>= H 0) (>= 1 H)) (>= F 1)) (>= C 1)) (>= E F)))
(rule (f21 A B C D E F G) (f10 A B C D E (- F 1) G) :guard (>= 0 G))
(rule (f21 A B C D E F G) (f10 A B C D E (+ F 1) G) :guard (>= G 1))
(rule
  (f10 A B C D E F G)
  (f31 A B C D E F G)
  :guard
  (and (>= 0 F) (>= E F)))
(rule (f10 A B C D E F G) (f31 A B C D E F G) :guard (>= F (+ 1 E)))
